{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "courier/courier-map",
	"version": "0.1.0",
	"title": "Map",
	"category": "embed",
	"icon": "location-alt",
	"description": "A map of locations, with address autofill and per-location details",
	"textdomain": "courier",
	"attributes": {
		"locations": {
			"type": "array",
			"default": [],
			"items": { "type": "object" }
		},
		"categories": {
			"type": "array",
			"default": [],
			"items": { "type": "object" }
		},
		"mapId": {
			"type": "string",
			"default": "DEMO_MAP_ID"
		},
		"accentColor": {
			"type": "string",
			"default": "#1c86c4"
		},
		"height": {
			"type": "number",
			"default": 400
		},
		"zoom": {
			"type": "number",
			"default": 12
		},
		"panelTitle": {
			"type": "string",
			"default": "Locations"
		},
		"panelTagline": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:index.ts",
	"editorStyle": "file:index.css",
	"style": [
		"file:style-index.css"
	],
	"render": "file:render.php",
	"viewScript": [
		"file:view.ts"
	]
}